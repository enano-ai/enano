      "normalisation": "currency_millions",
      "tolerance": 0.05,
      "temporal": true,
      "date_patterns": [
        {
          "id": "full_date",
          "regex": "\\b(\\d{1,2}\\s+(?:January|February|March|April|May|June|July|August|September|October|November|December)\\s+20\\d{2})\\b",
          "flags": "i",
          "capture_groups": {
            "date": 1
          }
        },
        {
          "id": "year_with_marker",
          "regex": "(?:as at|as of|at 31|year ended|year-end)[^.]{0,20}\\b(20\\d{2})\\b",
          "flags": "i",
          "capture_groups": {
            "date": 1
          }
        }
      ],
      "conflict_severity": "high",
      "description": "Firm-level AUM should be consistent across the document set for the same date. Tolerance of 5% handles rounding (2.6bn ≈ 2,614m)."
    },
